# Локальная разработка мобильного приложения. `npm run setup` копирует файл в .env.
# Все переменные EXPO_PUBLIC_* попадают в сборку приложения: секретов здесь быть не может.
#
# Симулятор iOS видит localhost компьютера напрямую. Для эмулятора Android
# пробросьте порты, чтобы адреса совпадали с issuer в токене:
#   adb reverse tcp:8080 tcp:8080
#   adb reverse tcp:8081 tcp:8081

# Адрес edge-прокси (deploy/compose).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# OIDC-провайдер и публичный клиент мобильного приложения (Authorization Code + PKCE).
EXPO_PUBLIC_OIDC_ISSUER=http://localhost:8081/realms/sozhiteli
EXPO_PUBLIC_OIDC_CLIENT_ID=sozhiteli-mobile
