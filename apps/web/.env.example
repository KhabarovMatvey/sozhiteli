# Локальная разработка web-приложения. `npm run setup` копирует файл в .env.local.
# Все переменные NEXT_PUBLIC_* попадают в браузер: секретов здесь быть не может.

# Адрес edge-прокси (deploy/compose).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# OIDC-провайдер и публичный клиент web-приложения (Authorization Code + PKCE).
NEXT_PUBLIC_OIDC_AUTHORITY=http://localhost:8081/realms/sozhiteli
NEXT_PUBLIC_OIDC_CLIENT_ID=sozhiteli-web
