# Значения ТОЛЬКО для локальной разработки. `npm run setup` копирует этот файл
# в .env (он в .gitignore). В любой общей или промышленной среде все значения
# заменяются на сгенерированные секреты из хранилища секретов.

POSTGRES_SUPERUSER_PASSWORD=dev-only-postgres

PROFILE_MIGRATOR_PASSWORD=dev-only-profile-migrator
PROFILE_APP_PASSWORD=dev-only-profile-app

MATCHING_MIGRATOR_PASSWORD=dev-only-matching-migrator
MATCHING_APP_PASSWORD=dev-only-matching-app

INTERACTION_MIGRATOR_PASSWORD=dev-only-interaction-migrator
INTERACTION_APP_PASSWORD=dev-only-interaction-app

KEYCLOAK_DB_PASSWORD=dev-only-keycloak-db
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin

# Должен совпадать с секретом клиента matching-service в keycloak/realm-dev.json.
MATCHING_CLIENT_SECRET=dev-only-matching-client-secret

# Origin web-приложения для CORS на edge-прокси.
WEB_ORIGIN=http://localhost:3000
# Мобильное приложение в веб-режиме Expo (только разработка).
MOBILE_WEB_ORIGIN=http://localhost:8082
