# Edge-прокси: единственная публичная точка входа в API (docs/adr/0006).
#
# Делает только транспортную работу: маршрутизация по префиксу, CORS,
# ограничение частоты запросов по IP, единый формат собственных ошибок.
# Бизнес-логики, агрегации ответов и проверки токенов здесь нет и быть не
# должно: токены проверяет каждый сервис сам.
#
# Внутренний API Profile (порт 9080) сюда НЕ проброшен.
#
# Файл - шаблон nginx: ${WEB_ORIGIN} подставляется при старте контейнера.

limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=20r/s;

map $http_origin $cors_origin {
    default                "";
    "${WEB_ORIGIN}"        $http_origin;
    # Только для разработки: мобильное приложение в веб-режиме Expo.
    "${MOBILE_WEB_ORIGIN}" $http_origin;
}

server {
    listen 8080;
    server_tokens off;
    client_max_body_size 64k;

    # Имена сервисов разрешаются при каждом запросе (DNS Docker), поэтому
    # перезапуск или масштабирование сервиса не требует перезапуска прокси.
    resolver 127.0.0.11 valid=10s ipv6=off;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s;
    proxy_send_timeout 10s;
    proxy_read_timeout 10s;

    # CORS. Пустой $cors_origin (чужой Origin) означает, что заголовок
    # Access-Control-Allow-Origin не добавляется и браузер блокирует ответ.
    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type, X-Request-Id" always;
    add_header Access-Control-Expose-Headers "X-Request-Id, Retry-After" always;
    add_header Access-Control-Max-Age 600 always;
    add_header Vary Origin always;
    add_header X-Content-Type-Options nosniff always;

    limit_req_status 429;

    # Ошибки самого прокси - в том же формате, что и ошибки сервисов.
    error_page 429 = @rate_limited;
    error_page 502 503 504 = @unavailable;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/profile/ {
        limit_req zone=api_per_ip burst=40 nodelay;
        if ($request_method = OPTIONS) { return 204; }
        set $upstream http://profile:8080;
        rewrite ^/api/profile/(.*)$ /$1 break;
        proxy_pass $upstream;
    }

    location /api/matching/ {
        limit_req zone=api_per_ip burst=40 nodelay;
        if ($request_method = OPTIONS) { return 204; }
        set $upstream http://matching:8080;
        rewrite ^/api/matching/(.*)$ /$1 break;
        proxy_pass $upstream;
    }

    location /api/interaction/ {
        limit_req zone=api_per_ip burst=40 nodelay;
        if ($request_method = OPTIONS) { return 204; }
        set $upstream http://interaction:8080;
        rewrite ^/api/interaction/(.*)$ /$1 break;
        proxy_pass $upstream;
    }

    location / {
        default_type application/problem+json;
        return 404 '{"type":"urn:sozhiteli:problem:not_found","title":"Not Found","status":404,"code":"not_found"}';
    }

    location @rate_limited {
        default_type application/problem+json;
        add_header Retry-After 1 always;
        add_header Access-Control-Allow-Origin $cors_origin always;
        add_header Vary Origin always;
        return 429 '{"type":"urn:sozhiteli:problem:rate_limited","title":"Too Many Requests","status":429,"code":"rate_limited"}';
    }

    location @unavailable {
        default_type application/problem+json;
        add_header Retry-After 2 always;
        add_header Access-Control-Allow-Origin $cors_origin always;
        add_header Vary Origin always;
        return 503 '{"type":"urn:sozhiteli:problem:service_unavailable","title":"Service Unavailable","status":503,"code":"service_unavailable"}';
    }
}
