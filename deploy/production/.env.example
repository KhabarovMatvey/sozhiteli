# Образец. Настоящий .env создаёт scripts/init-secrets.sh (случайные пароли,
# права 600). Файл .env не копировать в git, чаты и тикеты.

# Домен сайта без https:// (A-запись должна указывать на публичный IP сервера).
DOMAIN=example.ru

POSTGRES_SUPERUSER_PASSWORD=
PROFILE_MIGRATOR_PASSWORD=
PROFILE_APP_PASSWORD=
MATCHING_MIGRATOR_PASSWORD=
MATCHING_APP_PASSWORD=
INTERACTION_MIGRATOR_PASSWORD=
INTERACTION_APP_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
MATCHING_CLIENT_SECRET=

# Куда scripts/backup.sh складывает резервные копии и сколько дней их хранить.
BACKUP_DIR=/var/backups/sozhiteli
BACKUP_KEEP_DAYS=14
